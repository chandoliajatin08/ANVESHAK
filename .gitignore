# =============================================================================
# ANVESHAK Git Ignore Rules
# Protects secrets, dependencies, build outputs, and local hardware backups
# =============================================================================

# Dependencies
node_modules/
backend/node_modules/
.pnp
.pnp.js

# Production Build Outputs
dist/
dist-ssr/
build/
*.local

# Environment Variables & Private Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*serviceAccountKey*.json
service-account*.json

# Local Hardware Backups & Scratch Scripts
hardware/local_credentials_backup/
*_local.ino
*.bak
*.hex
*.bin
*.elf
test_serial.ps1

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS Temporary Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

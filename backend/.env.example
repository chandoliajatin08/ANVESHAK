# =============================================================================
# ANVESHAK Backend Environment Variables
# Copy this file to '.env' and configure your local bridge / Firebase settings.
# =============================================================================

PORT=5000
DEVICE_KEY=YOUR_DEVICE_SECRET_KEY
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Optional: Minified Google Service Account JSON or file path for server-side Firebase Admin sync
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id",...}'

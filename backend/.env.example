# =============================================================================
# ANVESHAK Backend Environment Variables
# Copy this file to '.env' and change the values for your laptop.
# =============================================================================

PORT=5000

# Serial port of the LoRa gateway (or the helmet when using the USB cable).
# Windows example: COM14   |   Linux: /dev/ttyUSB0   |   macOS: /dev/cu.usbserial-0001
# Leave empty to auto-detect.
SERIAL_PORT=
SERIAL_BAUD=115200

# Optional: if set, Wi-Fi HTTP packets must send this value in the X-Device-Key header.
DEVICE_KEY=

# Optional Firebase cloud sync (leave empty to run fully local)
FIREBASE_DATABASE_URL=
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id",...}'
